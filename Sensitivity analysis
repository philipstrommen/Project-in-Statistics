alphas <- c(0.01, 0.05, 0.10)

par(mfrow = c(1, 3))
for(a in alphas) {
  fit <- pc(suffStat, gaussCItest, alpha = a,
            labels = vars, verbose = FALSE)
  plot(fit, main = paste0("PC  α = ", a))
}
par(mfrow = c(1, 1))

cat(" PC edge counts by alpha \n")
for(a in alphas) {
  fit    <- pc(suffStat, gaussCItest, alpha = a,
               labels = vars, verbose = FALSE)
  amat   <- as(fit@graph, "matrix")
  nedges <- sum(amat > 0) / 2
  cat("alpha =", a, "→", nedges, "edges\n")

